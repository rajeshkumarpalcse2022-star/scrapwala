# Application
NEXT_PUBLIC_APP_NAME=ScrapWala

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/scrapwala?retryWrites=true&w=majority

# Authentication
AUTH_JWT_SECRET=your-secure-random-secret-here
AUTH_COOKIE_NAME=scrapwala_session
AUTH_SESSION_TTL=7d

# OTP
OTP_HASH_SECRET=your-otp-hash-secret-here
# false = REAL EMAIL MODE (OTP is only sent via Gmail, never returned to the frontend).
# true = development mode only (OTP may be mirrored in the API response for local testing).
AUTH_OTP_DEV_MODE=false

# SMTP (Nodemailer Gmail)
SMTP_USER=
SMTP_PASS=

# Admin Seed
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
